{
  "name": "cratie",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p test/integration",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "jest",
    "test:integration": "jest -c test/integration/jest.config.js",
    "test:native": "cd android && ./gradlew :cratie-player:testDebugUnitTest :cratie-icons:testDebugUnitTest",
    "ma:start": "scripts/ma-server.sh start",
    "ma:stop": "scripts/ma-server.sh stop",
    "e2e:build:android": "detox build -c android.emu",
    "e2e:android": "detox test -c android.emu",
    "e2e:build:android:debug": "detox build -c android.emu.debug",
    "e2e:android:debug": "E2E_DEV_CLIENT=1 detox test -c android.emu.debug",
    "build:icons": "node scripts/build-icons.mjs",
    "check:icons": "node scripts/build-icons.mjs --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "^3.6.0",
    "@react-native-community/slider": "5.2.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "57.0.27",
    "expo-build-properties": "^57.0.22",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-router": "57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-true-image": "^2.0.1",
    "react-native-unistyles": "^3.3.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.11",
    "detox": "^20.51.4",
    "jest": "^30.5.1",
    "jest-expo": "^57.0.5",
    "opentype.js": "2.0.0",
    "typescript": "~6.0.3"
  }
}
