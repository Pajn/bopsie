{
  "expo": {
    "name": "Bopsie",
    "slug": "bopsie",
    "version": "0.1.0",
    "scheme": ["bopsie", "cratie"],
    "orientation": "portrait",
    "icon": "./assets/brand/bopsie-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "io.github.pajn.cratie",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "io.github.pajn.cratie",
      "adaptiveIcon": {
        "backgroundColor": "#3E1C78",
        "foregroundImage": "./assets/brand/android-icon-foreground.png",
        "monochromeImage": "./assets/brand/android-icon-monochrome.png"
      },
      "versionCode": 1,
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "react-native-edge-to-edge",
      "./plugins/withDetox.js",
      "./plugins/withPinnedAndroidTools.js",
      "./plugins/withGradleSettings.js",
      "./plugins/withQuietDevMenu.js",
      "./plugins/withUserCertificates.js",
      "./plugins/withBaselineProfile.js",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withDevLauncherWaiting.js",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
