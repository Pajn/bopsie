{
  "name": "bopsie",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p test/integration",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "jest",
    "test:integration": "jest -c test/integration/jest.config.js",
    "test:native": "cd android && ./gradlew :bopsie-player:testDebugUnitTest :bopsie-icons:testDebugUnitTest",
    "server:start": "scripts/test-server.sh start",
    "server:stop": "scripts/test-server.sh stop",
    "e2e:build:android": "detox build -c android.emu",
    "e2e:android": "detox test -c android.emu",
    "e2e:build:android:debug": "detox build -c android.emu.debug",
    "e2e:android:debug": "E2E_DEV_CLIENT=1 detox test -c android.emu.debug",
    "perf:startup:android": "node scripts/perf/startup.ts",
    "perf:profile:android": "node scripts/perf/baseline-profile.ts",
    "build:icons": "node scripts/build-icons.mjs",
    "check:icons": "node scripts/build-icons.mjs --check"
  },
  "dependencies": {
    "@bopsie/client": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "^3.6.0",
    "@react-native-community/slider": "5.2.1",
    "@tanstack/react-query": "^5.102.8",
    "expo": "58.0.13",
    "expo-build-properties": "^58.0.10",
    "expo-constants": "~58.0.12",
    "expo-dev-client": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.13",
    "expo-router": "58.0.22",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-reorderable-list": "0.18.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-true-image": "^2.2.0",
    "react-native-unistyles": "^3.3.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@react-native/metro-config": "0.88.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.17",
    "detox": "^20.51.4",
    "jest": "^30.5.1",
    "jest-expo": "^58.0.11",
    "opentype.js": "2.0.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  },
  "reanimated": {
    "staticFeatureFlags": {
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  }
}
